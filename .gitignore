# =============================================================================
# ClanLib .gitignore
# Covers: CMake, Visual Studio, VS Code, C/C++ toolchain, GNU autotools.
# =============================================================================
#
# NOTE - intentionally NOT ignored here (all tracked in this repo, verified
# with `git ls-files`):
#   *.sln / *.vcxproj / *.vcxproj.filters  (149+ upstream VS projects)
#   Makefile                               (100 hand-written Example/Test
#                                           makefiles; autotools output is
#                                           instead covered via Makefile.in,
#                                           config.* and .deps/ below)
#   *.m4 / *.pc.in / Makefile.am / configure.ac / autogen.sh (build sources)
#   configure.exe and Tests/Display/SpriteSpeed1/*.exe (tracked binaries;
#                                           gitignore never affects them)
#   *.user / *.pch                        (one legacy file of each is tracked;
#                                           the rules below only apply to new,
#                                           untracked files)
#
# =============================================================================
# CMake (out-of-tree builds; in-source files if ever configured in-tree)
# =============================================================================
/build*/
/out/
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
CMakeScripts/
Testing/
install_manifest.txt
compile_commands.json
CPackConfig.cmake
CPackSourceConfig.cmake
_CPack_Packages/

# =============================================================================
# Visual Studio
# =============================================================================
# Per-user and cache files
.vs/
*.user
*.userosscache
*.suo
*.sln.docstates
*.userprefs
*.pidb
*.scc
*.psess
*.vsp
*.vspx

# Build output directories
[Bb]in/
[Oo]bj/
x64/
x86/
[Dd]ebug/
[Rr]elease/
ipch/

# Build and debug artifacts
*.aps
*.ncb
*.sdf
*.opensdf
*.opendb
*.VC.db
*.VC.VC.opendb
*.ilk
*.meta
*.obj
*.iobj
*.ipdb
*.pdb
*.idb
*.pgc
*.pgd
*.exp
*.map
*.sbr
*.tlb
*.tli
*.tlh
*.tlog
*.lastbuildstate
*.unsuccessfulbuild
*.rsp
*.sbr
*.bsc
*.cachefile
*.dbg
*.dmp
*.stackdump
*.tmp
*.log
*.vspscc
*.vssscc
*.nav

# Test and benchmark results
TestResult.xml
[Tt]est[Rr]esult*/
BenchmarkDotNet.Artifacts/

# Windows store apps
AppX/

# =============================================================================
# Visual Studio Code
# =============================================================================
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace
.history/

# =============================================================================
# C / C++ toolchain
# =============================================================================
# Object files and archives
*.o
*.obj
*.lo
*.la
*.a
.libs/

# Precompiled headers
*.gch
*.pch

# Shared / static libraries and executables
*.so
*.so.*
*.dylib
*.dll
*.lib
*.exe
*.out
*.app
*.hex

# Dependency tracking
*.d
*.dep
.deps/
.dirstamp

# Coverage
*.gcda
*.gcno
*.gcov

# pkg-config files generated by configure (templates are *.pc.in, tracked)
**/*.pc

# Patch / merge leftovers and backups
*.orig
*.rej
*.bak
*~

# =============================================================================
# GNU autotools (run ./autogen.sh to regenerate; never commit its output)
# =============================================================================
# Generated top-level script (note: tracked configure.exe is unaffected -
# this rule only matches the extensionless file)
/configure
/config.status
/config.log
/config.cache
config.status
config.log
config.cache
autom4te.cache/
aclocal.m4
Makefile.in
ar-lib
compile
config.guess
config.sub
depcomp
install-sh
ltmain.sh
missing
mkinstalldirs
py-compile
test-driver
libtool
stamp-h1

# =============================================================================
# ClanLib generated docs
# =============================================================================
Documentation/html/
Documentation/latex/

# =============================================================================
# OS noise
# =============================================================================
.DS_Store
Thumbs.db
desktop.ini

# =============================================================================
# End of .gitignore
# =============================================================================
